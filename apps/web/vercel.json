{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm --dir ../.. install --frozen-lockfile",
  "buildCommand": "pnpm --dir ../.. build:vercel",
  "fluid": true,
  "crons": [{ "path": "/api/cron/reconcile", "schedule": "0 3 * * *" }],
  "functions": {
    "app/.well-known/workflow/**/route.js": { "maxDuration": 300 }
  }
}
