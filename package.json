{
  "name": "attendback",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1",
    "worker": "node --import tsx apps/worker/src/index.ts",
    "db:start": "node --import tsx scripts/postgres.ts",
    "db:migrate": "node --import tsx packages/db/src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "codegen": "node --import tsx scripts/codegen.ts",
    "program:build": "NO_DNA=1 anchor build"
  },
  "dependencies": {
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "@solana/kit-plugin-wallet": "0.21.0",
    "@solana/react": "8.4.0",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@playwright/test": "1.63.0",
    "@solana/kit-plugin-litesvm": "0.19.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "codama": "1.11.0",
    "embedded-postgres": "18.4.0-beta.17",
    "litesvm": "1.5.0",
    "prettier": "3.8.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
